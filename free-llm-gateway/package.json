{
  "name": "free-llm-gateway",
  "version": "1.0.0",
  "description": "Zero-cost unified AI gateway for 9+ free LLM providers with intelligent routing and dynamic model discovery",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test dist/tests/**/*.test.js",
    "test:watch": "npm run build && npm run test -- --watch",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "llm",
    "ai",
    "gateway",
    "free",
    "routing",
    "openai",
    "claude",
    "gemini",
    "failover",
    "discovery"
  ],
  "author": "bulk-direct",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/allotarik16-coder/bulk-direct.git",
    "directory": "free-llm-gateway"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.2.2",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
